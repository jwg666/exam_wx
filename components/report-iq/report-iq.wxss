.rp { width: 100%; }
.rp-main { box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.25); }
.rp-brain { font-size: 56rpx; }

.rp-cat { margin-bottom: 20rpx; }
.rp-cat:last-child { margin-bottom: 0; }

.rp-cell {
  background: rgba(11, 17, 32, 0.6);
  border: 1rpx solid #243049;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.rp-note {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.7;
  display: flex;
  gap: 8rpx;
}
