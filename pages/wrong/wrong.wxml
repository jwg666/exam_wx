<view class="page wr-page">

  <!-- 未登录空态（登录守卫触发） -->
  <view wx:if="{{guest}}" class="empty">
    <text class="empty-emoji">🔐</text>
    <text>登录后查看错题本</text>
  </view>

  <block wx:else>
    <!-- 页头：标题 + 清空（有错题时显示） -->
    <view class="page-header wr-header">
      <text class="section-title">错题本</text>
      <text wx:if="{{totalCount > 0}}" class="wr-clear" bindtap="onClearAll">🗑️ 清空</text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="spinner"></view>
    </view>

    <!-- 空态（对齐 Web：太棒了！没有错题） -->
    <view wx:elif="{{list.length === 0}}" class="wr-empty fade-up">
      <view class="wr-empty-icon"><text>✅</text></view>
      <text class="wr-empty-title">太棒了！没有错题</text>
      <text class="wr-empty-sub">继续保持，百尺竿头更进一步</text>
      <view class="g-btn g-btn-primary wr-go" bindtap="goPractice">去刷题 ›</view>
    </view>

    <block wx:else>
      <!-- 分类筛选 chips（题库数 > 1 时显示） -->
      <scroll-view wx:if="{{chips.length > 1}}" class="wr-chips" scroll-x="true">
        <view
          wx:for="{{chips}}"
          wx:key="id"
          class="wr-chip {{activeType === item.id ? 'wr-chip-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onChipTap"
        >{{item.name}}</view>
      </scroll-view>

      <!-- 错题列表 -->
      <view
        class="g-card wr-card fade-up"
        wx:for="{{list}}"
        wx:key="id"
        style="animation-delay: {{item.delay}}s;"
      >
        <view class="wr-stripe"></view>

        <!-- 题型标签 + 题干 + 移除 -->
        <view class="wr-top">
          <view class="wr-head">
            <text class="g-tag wr-type {{item.typeCls}}">{{item.typeLabel}}</text>
            <text class="wr-question">{{item.question}}</text>
          </view>
          <view class="wr-del" data-id="{{item.id}}" bindtap="onRemove">🗑️</view>
        </view>

        <!-- 正确答案 + 解析 -->
        <view class="wr-body">
          <text class="wr-ans">正确答案：<text class="wr-ans-val">{{item.ansText}}</text></text>
          <text wx:if="{{item.hasExp}}" class="wr-exp">{{item.exp}}</text>
        </view>

        <!-- 底部：来源题库 + 重做 -->
        <view class="wr-foot">
          <text class="wr-bank">📖 {{item.bankName}}</text>
          <text class="wr-retry" data-id="{{item.id}}" bindtap="onRetry">🔄 重做</text>
        </view>
      </view>
    </block>
  </block>
</view>
