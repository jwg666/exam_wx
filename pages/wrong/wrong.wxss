/* 错题本（对齐 Web pages/wrong.vue） */
.wr-page {
  padding-bottom: 64rpx;
  box-sizing: border-box;
}

/* ---------- 页头 ---------- */
.wr-header { min-height: 88rpx; }
.wr-clear {
  font-size: 28rpx;
  font-weight: 500;
  color: #F87171;
  padding: 8rpx 0;
}
.wr-clear:active { color: #FCA5A5; }

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #243049;
  border-top-color: #14B8A6;
  border-radius: 50%;
  animation: wr-spin 0.8s linear infinite;
}
@keyframes wr-spin {
  to { transform: rotate(360deg); }
}

/* ---------- 空态 ---------- */
.wr-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}
.wr-empty-icon {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: #162032;
  border: 1rpx solid rgba(36, 48, 73, 0.5);
  box-shadow: inset 0 0 20rpx rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
}
.wr-empty-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #94A3B8;
  margin-bottom: 8rpx;
}
.wr-empty-sub {
  font-size: 24rpx;
  color: #64748B;
}
.wr-go {
  width: 280rpx;
  padding: 18rpx 0;
  margin-top: 48rpx;
  font-size: 28rpx;
}

/* ---------- 分类筛选 chips ---------- */
.wr-chips {
  margin: 8rpx 40rpx 16rpx;
  white-space: nowrap;
}
.wr-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #162032;
  color: #94A3B8;
}
.wr-chip-on {
  background: #14B8A6;
  color: #FFFFFF;
}

/* ---------- 错题卡 ---------- */
.wr-card {
  position: relative;
  overflow: hidden;
  margin: 0 40rpx 32rpx;
}
.wr-stripe {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #EF4444, #F97316);
}
.wr-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.wr-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.wr-type {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  margin-top: 4rpx;
}
.tag-single { background: rgba(20, 184, 166, 0.2); color: #2DD4BF; }
.tag-judge { background: rgba(59, 130, 246, 0.2); color: #60A5FA; }
.tag-multi { background: rgba(139, 92, 246, 0.2); color: #C084FC; }
.wr-question {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #E8EDF5;
  text-align: justify;
}
.wr-del {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #162032;
  border: 1rpx solid #243049;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.wr-del:active { background: rgba(239, 68, 68, 0.2); }

/* ---------- 答案 / 解析 ---------- */
.wr-body { margin-bottom: 16rpx; }
.wr-ans {
  display: block;
  font-size: 28rpx;
  color: #94A3B8;
  line-height: 1.6;
}
.wr-ans-val {
  color: #4ADE80;
  font-weight: 700;
}
.wr-exp {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
  margin-top: 16rpx;
}

/* ---------- 底部 ---------- */
.wr-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid #243049;
  font-size: 24rpx;
  font-weight: 500;
  color: #64748B;
}
.wr-bank { color: #64748B; }
.wr-retry {
  color: #2DD4BF;
  font-weight: 700;
}
.wr-retry:active { color: #5EEAD4; }
