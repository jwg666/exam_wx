<view class="page hs-page">

  <!-- 未登录空态（登录守卫触发） -->
  <view wx:if="{{guest}}" class="empty">
    <text class="empty-emoji">🔐</text>
    <text>登录后查看练习记录</text>
  </view>

  <block wx:else>
    <!-- 页头：标题 + 共 N 次 -->
    <view class="page-header hs-header">
      <text class="section-title">练习记录</text>
      <text class="hs-count">共 <text class="hs-count-num">{{total}}</text> 次</text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="spinner"></view>
    </view>

    <!-- 空态（对齐 Web：暂无练习记录） -->
    <view wx:elif="{{list.length === 0}}" class="hs-empty fade-up">
      <view class="hs-empty-icon"><text>🕘</text></view>
      <text class="hs-empty-text">暂无练习记录</text>
      <view class="g-btn g-btn-primary hs-go" bindtap="goPractice">去刷题 ›</view>
    </view>

    <block wx:else>
      <!-- 记录列表 -->
      <view
        class="g-card hs-card fade-up"
        wx:for="{{list}}"
        wx:key="id"
        style="animation-delay: {{item.delay}}s;"
      >
        <view class="hs-stripe {{item.good ? 'hs-stripe-ok' : 'hs-stripe-bad'}}"></view>

        <!-- 题库名 + 时间 | 得分 -->
        <view class="hs-top">
          <view class="hs-info">
            <text class="hs-bank">{{item.bankName}}</text>
            <text class="hs-date">{{item.dateText}}</text>
          </view>
          <view class="hs-score-wrap">
            <text class="hs-score {{item.good ? 'hs-score-ok' : 'hs-score-bad'}}">{{item.accuracy}}</text>
            <text class="hs-score-unit">分</text>
          </view>
        </view>

        <!-- 底部：用时 + 对错数 -->
        <view class="hs-foot">
          <text class="hs-time">⏱️ 用时 {{item.durationText}}</text>
          <view class="hs-right">
            <text class="hs-ok">✅ {{item.correct}}</text>
            <text class="hs-bad">❌ {{item.wrong}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>
