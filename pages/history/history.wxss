/* 答题历史（对齐 Web pages/history.vue） */
.hs-page {
  padding-bottom: 64rpx;
  box-sizing: border-box;
}

/* ---------- 页头 ---------- */
.hs-header { min-height: 88rpx; }
.hs-count {
  font-size: 28rpx;
  font-weight: 500;
  color: #94A3B8;
}
.hs-count-num {
  color: #14B8A6;
  font-weight: 700;
}

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #243049;
  border-top-color: #14B8A6;
  border-radius: 50%;
  animation: hs-spin 0.8s linear infinite;
}
@keyframes hs-spin {
  to { transform: rotate(360deg); }
}

/* ---------- 空态 ---------- */
.hs-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}
.hs-empty-icon {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: #162032;
  border: 1rpx solid rgba(36, 48, 73, 0.5);
  box-shadow: inset 0 0 20rpx rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
}
.hs-empty-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #94A3B8;
}
.hs-go {
  width: 280rpx;
  padding: 18rpx 0;
  margin-top: 48rpx;
  font-size: 28rpx;
}

/* ---------- 记录卡 ---------- */
.hs-card {
  position: relative;
  overflow: hidden;
  margin: 0 40rpx 32rpx;
}
.hs-stripe {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}
.hs-stripe-ok { background: linear-gradient(180deg, #2DD4BF, #0D9488); }
.hs-stripe-bad { background: linear-gradient(180deg, #F87171, #F97316); }

.hs-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.hs-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.hs-bank {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8EDF5;
  margin-bottom: 8rpx;
}
.hs-date {
  font-size: 24rpx;
  font-weight: 500;
  color: #64748B;
}
.hs-score-wrap {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.hs-score {
  font-size: 48rpx;
  font-weight: 900;
}
.hs-score-ok { color: #2DD4BF; }
.hs-score-bad { color: #F87171; }
.hs-score-unit {
  font-size: 24rpx;
  font-weight: 700;
  color: #64748B;
  margin-left: 4rpx;
}

/* ---------- 底部 ---------- */
.hs-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid #243049;
  font-size: 24rpx;
  font-weight: 500;
}
.hs-time { color: #94A3B8; }
.hs-right {
  display: flex;
  gap: 24rpx;
}
.hs-ok { color: #4ADE80; }
.hs-bad { color: #F87171; }
