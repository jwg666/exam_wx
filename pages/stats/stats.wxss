/* 数据分析 / 学习报告（对齐 Web pages/stats.vue） */
.stats-page {
  padding: 16rpx 40rpx 64rpx;
  box-sizing: border-box;
}

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #243049;
  border-top-color: #14B8A6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.sec-2 { animation-delay: 0.1s; }
.sec-3 { animation-delay: 0.15s; }
.sec-4 { animation-delay: 0.2s; }

/* ---------- 核心指标 ---------- */
.stats-grid {
  display: flex;
  gap: 32rpx;
}
.metric {
  flex: 1;
  position: relative;
  overflow: hidden;
  padding: 40rpx;
  background: linear-gradient(135deg, #1C2942, #162032);
}
.metric-wm {
  position: absolute;
  right: -32rpx;
  bottom: -32rpx;
  font-size: 120rpx;
  opacity: 0.1;
}
.metric-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #94A3B8;
  margin-bottom: 16rpx;
}
.metric-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.metric-dot-teal { background: #2DD4BF; }
.metric-dot-orange { background: #FB923C; }
.metric-num {
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.2;
}
.metric-num-acc {
  background: linear-gradient(135deg, #5EEAD4, #3B82F6);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.metric-num-streak {
  background: linear-gradient(135deg, #FB923C, #EF4444);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.metric-unit {
  font-size: 28rpx;
  font-weight: 700;
  color: #64748B;
}

/* ---------- 通用卡片 ---------- */
.stats-card { padding: 48rpx; }
.stats-card-mb { margin-bottom: 64rpx; }
.stats-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 48rpx;
}
.stats-icon { font-size: 32rpx; }
.stats-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8EDF5;
}
.stats-empty {
  text-align: center;
  font-size: 28rpx;
  color: #64748B;
  padding: 32rpx 0;
}
.bytype-head { margin-bottom: 8rpx; }

/* ---------- 近7天柱状图（view 高度百分比，无 canvas） ---------- */
.chart-area {
  height: 320rpx;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  border-bottom: 1rpx solid #243049;
  padding-bottom: 16rpx;
}
.chart-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}
.chart-val {
  font-size: 20rpx;
  font-weight: 700;
  color: #94A3B8;
  margin-bottom: 8rpx;
}
.chart-bar {
  width: 48rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(to top, rgba(13, 148, 136, 0.5), #2DD4BF);
  transition: height 0.5s;
}
.chart-labels {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.chart-day {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  font-weight: 500;
  color: #64748B;
}
