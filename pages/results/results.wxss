/* 成果 Tab：测评报告 + 最近学习 + 学习排行榜（对齐 Web pages/results.vue） */
.results-page {
  padding: 16rpx 40rpx 64rpx;
  box-sizing: border-box;
}

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #243049;
  border-top-color: #14B8A6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.section { margin-bottom: 64rpx; }
.sec-2 { animation-delay: 0.1s; }
.sec-3 { animation-delay: 0.2s; }

/* ---------- 测评报告 ---------- */
.rep-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 64rpx 32rpx;
}
.rep-empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #162032;
  border: 1rpx solid rgba(36, 48, 73, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 32rpx;
}
.rep-empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #94A3B8;
  margin-bottom: 8rpx;
}
.rep-empty-sub {
  font-size: 24rpx;
  color: #64748B;
  margin-bottom: 40rpx;
}
.rep-empty-btn {
  padding: 16rpx 48rpx;
  font-size: 28rpx;
}

.rep-card { border-radius: 24rpx; }
.rep-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rep-icon-emoji { font-size: 40rpx; }
.rep-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #E8EDF5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rep-date {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}
.rep-key {
  align-items: flex-end;
  flex-shrink: 0;
}
.rep-num {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}
.rep-key-label {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}
.rep-chev {
  font-size: 24rpx;
  color: #64748B;
  margin-left: 8rpx;
  transition: transform 0.2s;
}
.rep-chev-open { transform: rotate(180deg); }
.rep-detail {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #243049;
}

/* ---------- 最近学习（BankCard） ---------- */
.hot-empty {
  padding: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #64748B;
}
.bank-row { align-items: flex-start; }
.bank-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bank-icon-emoji { font-size: 48rpx; }
.bank-name-row { margin-bottom: 8rpx; }
.bank-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8EDF5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bank-done { font-size: 28rpx; }
.bank-desc {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bank-tags { margin-bottom: 24rpx; }
.bank-tag2 {
  background: #1C2942;
  color: #94A3B8;
}
.type-exam { background: rgba(239, 68, 68, 0.12); color: #F87171; }
.type-skill { background: rgba(13, 148, 136, 0.12); color: #2DD4BF; }
.type-license { background: rgba(251, 146, 60, 0.12); color: #FDBA74; }
.type-language { background: rgba(168, 85, 247, 0.12); color: #C084FC; }
.type-interest { background: rgba(34, 197, 94, 0.12); color: #4ADE80; }
.type-other { background: #1C2942; color: #94A3B8; }
.diff-easy { color: #4ADE80; }
.diff-mid { color: #FBBF24; }
.diff-hard { color: #F87171; }
.bank-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: #14B8A6;
}

/* ---------- 学习排行榜 ---------- */
.rank-card { padding: 16rpx; }
.rank-empty {
  text-align: center;
  padding: 48rpx 0;
  font-size: 28rpx;
  color: #64748B;
}
.rank-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid transparent;
}
.rank-row-me {
  background: rgba(20, 184, 166, 0.1);
  border-color: rgba(20, 184, 166, 0.3);
}
.rank-no {
  width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #64748B;
  flex-shrink: 0;
}
.rk-1 { color: #FBBF24; }
.rk-2 { color: #C0C0C0; }
.rk-3 { color: #FB923C; }
.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1C2942, #162032);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #94A3B8;
  flex-shrink: 0;
}
.rank-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #E8EDF5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-me-tag {
  color: #2DD4BF;
  font-size: 24rpx;
  font-weight: 400;
}
.rank-sub {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}
.rank-total {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #2DD4BF;
}
.rank-unit {
  font-size: 20rpx;
  color: #64748B;
  font-weight: 400;
}
