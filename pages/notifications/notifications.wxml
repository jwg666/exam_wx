<view class="page nf-page">

  <!-- 未登录空态（登录守卫触发） -->
  <view wx:if="{{guest}}" class="empty">
    <text class="empty-emoji">🔐</text>
    <text>登录后查看消息通知</text>
  </view>

  <block wx:else>
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="spinner"></view>
    </view>

    <!-- 空态 -->
    <view wx:elif="{{list.length === 0}}" class="nf-empty fade-up">
      <view class="nf-empty-icon"><text>🔔</text></view>
      <text class="nf-empty-text">暂无消息</text>
    </view>

    <block wx:else>
      <!-- 全部已读 -->
      <view wx:if="{{unread > 0}}" class="nf-top">
        <text class="mark-read {{marking ? 'mark-read-disabled' : ''}}" bindtap="markAllRead">全部已读</text>
      </view>

      <!-- 通知列表 -->
      <view
        class="g-card nf-item {{item.is_read ? 'nf-read' : ''}} fade-up"
        wx:for="{{list}}"
        wx:key="id"
        style="animation-delay: {{item.delay}}s;"
      >
        <view class="nf-icon {{item.boxClass}}">
          <text class="nf-icon-emoji">{{item.emoji}}</text>
        </view>
        <view class="grow nf-body">
          <view wx:if="{{!item.is_read}}" class="nf-dot"></view>
          <text class="nf-title {{item.is_read ? 'nf-title-read' : ''}}">{{item.title}}</text>
          <text wx:if="{{item.content}}" class="nf-content">{{item.content}}</text>
          <text class="nf-time">{{item.timeText}}</text>
        </view>
      </view>
    </block>
  </block>
</view>
