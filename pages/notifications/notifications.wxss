/* 消息通知（对齐 Web pages/notifications.vue） */
.nf-page {
  padding: 16rpx 40rpx 64rpx;
  box-sizing: border-box;
}

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #243049;
  border-top-color: #14B8A6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- 空态 ---------- */
.nf-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.nf-empty-icon {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: #162032;
  border: 1rpx solid rgba(36, 48, 73, 0.5);
  box-shadow: inset 0 0 20rpx rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
}
.nf-empty-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #94A3B8;
}

/* ---------- 全部已读 ---------- */
.nf-top {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}
.mark-read {
  font-size: 28rpx;
  font-weight: 500;
  color: #94A3B8;
  padding: 8rpx 0;
}
.mark-read:active { color: #14B8A6; }
.mark-read-disabled { opacity: 0.5; }

/* ---------- 通知列表 ---------- */
.nf-item {
  display: flex;
  gap: 32rpx;
  margin-bottom: 32rpx;
}
.nf-read { opacity: 0.6; }
.nf-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.nf-icon-emoji { font-size: 36rpx; }
.nf-sys { background: rgba(59, 130, 246, 0.2); }
.nf-rank { background: rgba(20, 184, 166, 0.2); }
.nf-ach { background: rgba(245, 158, 11, 0.2); }

.nf-body {
  position: relative;
}
.nf-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #EF4444;
}
.nf-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #E8EDF5;
  margin-bottom: 8rpx;
  padding-right: 16rpx;
}
.nf-title-read { color: #94A3B8; }
.nf-content {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.nf-time {
  font-size: 20rpx;
  font-weight: 500;
  color: #475569;
}
