/* 成就中心（对齐 Web pages/achievements.vue） */
.ach-page {
  padding: 16rpx 40rpx 64rpx;
  box-sizing: border-box;
}

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #243049;
  border-top-color: #14B8A6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- 顶部解锁计数 ---------- */
.ach-top {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

/* ---------- 收集进度卡 ---------- */
.ach-progress {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 48rpx;
  background: linear-gradient(90deg, #1C2942, #162032);
}
.ach-trophy {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #0B1120;
  border: 4rpx solid #FBBF24;
  box-shadow: 0 0 30rpx rgba(251, 191, 36, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.ach-progress-head { margin-bottom: 16rpx; }
.ach-pct { color: #FBBF24; }
.ach-bar { background: #0B1120; }
.ach-fill {
  background: linear-gradient(90deg, #F59E0B, #FDE047);
}

/* ---------- 徽章墙（2 列网格） ---------- */
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.ach-card {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 32rpx 24rpx;
}
.ach-on {
  border-color: rgba(251, 191, 36, 0.3);
  background: linear-gradient(180deg, rgba(245, 158, 11, 0.1), #162032);
}
.ach-off {
  opacity: 0.6;
  filter: grayscale(1);
}
.ach-glow {
  position: absolute;
  right: -48rpx;
  top: -48rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(251, 191, 36, 0.2);
  filter: blur(40rpx);
}
.ach-chip {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #1C2942;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}
.ach-emoji { font-size: 48rpx; }
.ach-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #E8EDF5;
  margin-bottom: 8rpx;
}
.ach-name-off { color: #94A3B8; }
.ach-desc {
  font-size: 20rpx;
  color: #64748B;
  line-height: 1.4;
  padding: 0 8rpx;
}
.ach-date {
  font-size: 20rpx;
  color: #FBBF24;
  margin-top: 12rpx;
}
.ach-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 28rpx;
}
