/* 登录/注册页：还原 Web 版光斑氛围与表单样式 */
.login-page {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
}

.login-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

/* ---------- 渐变光斑 blob ---------- */
.blob {
  position: absolute;
  border-radius: 50%;
  animation: blobFloat 14s ease-in-out infinite;
}
.blob-teal {
  width: 800rpx;
  height: 800rpx;
  top: -200rpx;
  left: -200rpx;
  background: radial-gradient(circle, rgba(20, 184, 166, 0.28) 0%, rgba(20, 184, 166, 0) 70%);
}
.blob-blue {
  width: 600rpx;
  height: 600rpx;
  top: 20%;
  right: -120rpx;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.25) 0%, rgba(37, 99, 235, 0) 70%);
  animation-delay: -2s;
}
.blob-purple {
  width: 700rpx;
  height: 700rpx;
  bottom: -100rpx;
  left: 10%;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.25) 0%, rgba(139, 92, 246, 0) 70%);
  animation-delay: -4s;
}
@keyframes blobFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-48rpx); }
}

/* ---------- 上浮粒子 ---------- */
.particle {
  position: absolute;
  bottom: 0;
  border-radius: 50%;
  animation: rise 12s linear infinite;
}
.p-teal {
  width: 6rpx;
  height: 6rpx;
  left: 10%;
  background: rgba(45, 212, 191, 0.7);
  animation-duration: 12s;
}
.p-blue {
  width: 10rpx;
  height: 10rpx;
  left: 40%;
  background: rgba(96, 165, 250, 0.7);
  animation-delay: -5s;
  animation-duration: 15s;
}
.p-purple {
  width: 6rpx;
  height: 6rpx;
  left: 80%;
  background: rgba(196, 181, 253, 0.7);
  animation-delay: -2s;
  animation-duration: 10s;
}
@keyframes rise {
  0% { transform: translateY(0); opacity: 0; }
  10% { opacity: 0.8; }
  90% { opacity: 0.6; }
  100% { transform: translateY(-90vh); opacity: 0; }
}

/* ---------- 内容层 ---------- */
.content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 品牌区 */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}
.brand-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #14B8A6, #2DD4BF);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 0 80rpx rgba(13, 148, 136, 0.4);
}
.brand-title {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  color: #E8EDF5;
}
.brand-sub {
  font-size: 30rpx;
  color: #94A3B8;
}

/* 登录卡片 */
.auth-card {
  background: rgba(22, 32, 50, 0.85);
  border: 1rpx solid #243049;
  border-radius: 32rpx;
  padding: 48rpx;
}

/* 登录方式分段切换 */
.seg {
  display: flex;
  background: rgba(11, 17, 32, 0.5);
  border: 1rpx solid #243049;
  border-radius: 20rpx;
  padding: 8rpx;
}
.seg-item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #64748B;
  border-radius: 14rpx;
}
.seg-item.seg-active {
  background: #14B8A6;
  color: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(13, 148, 136, 0.3);
}

/* 输入框（带 emoji 前缀图标） */
.field {
  position: relative;
  margin-bottom: 32rpx;
}
.field-ico {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  z-index: 2;
}
.field-input {
  height: 88rpx;
  /* 原生 input 无固定高度时真机渲染会被压扁：锁定高度、只留水平内边距，文字由组件垂直居中 */
  padding: 0 28rpx 0 72rpx;
  background: rgba(11, 17, 32, 0.5);
}
.field-input-eye {
  padding-right: 80rpx;
}
.field-eye {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  padding: 8rpx;
  z-index: 2;
}

/* 验证码行 */
.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.code-field {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}
.code-row .code-field {
  margin-bottom: 0;
}
.send-btn {
  flex-shrink: 0;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #162032;
  border: 1rpx solid #243049;
  color: #2DD4BF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0 28rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
.send-btn-disabled {
  opacity: 0.5;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  margin-top: 16rpx;
  box-sizing: border-box;
}

/* 登录/注册切换 */
.switch-row {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}
.switch-txt {
  font-size: 26rpx;
  color: #64748B;
}

/* 底部协议 */
.agreement {
  margin-top: 64rpx;
  text-align: center;
  font-size: 22rpx;
  color: #64748B;
}
.agree-link {
  color: #14B8A6;
}
