<!-- 游客：登录守卫（对齐 Web auth.global.ts，/bank/[id] 需登录） -->
<view wx:if="{{guest}}" class="page">
  <view class="empty">
    <text class="empty-emoji">🔒</text>
    <text>登录后才能查看题库详情</text>
    <button class="g-btn g-btn-primary guest-login-btn" hover-class="btn-hover" bindtap="goLogin">去登录</button>
  </view>
</view>

<!-- 题库详情 -->
<block wx:elif="{{bank}}">
  <view class="page detail-page">
    <!-- 顶部封面 -->
    <view class="cover" style="background: {{coverBg}}">
      <view class="row gap-3 cover-head">
        <view class="cover-ico">{{bank.emoji}}</view>
        <view class="col cover-title-box">
          <text class="cover-name">{{bank.name}}</text>
          <text wx:if="{{bank.typeName || bank.difficulty}}" class="cover-tags">{{bank.typeName}}{{bank.typeName && bank.difficulty ? ' · ' : ''}}{{bank.difficulty}}</text>
        </view>
      </view>
    </view>

    <view class="detail-body">
      <!-- 详细信息 + 学习进度 -->
      <view class="g-card info-card">
        <text class="bank-desc-text">{{bank.description}}</text>
        <view class="row between prog-title">
          <text class="t-sm t-bold">学习进度</text>
          <text class="t-sm t-bold c-teal">{{pct}}%</text>
        </view>
        <view class="progress-bar prog-bar">
          <view class="progress-fill" style="width:{{pct}}%"></view>
        </view>
        <view class="row between">
          <text class="t-xs c-muted">已学习 {{progress}} 题</text>
          <text class="t-xs c-muted">共 {{bank.total}} 题</text>
        </view>
      </view>

      <!-- 数据面板：总题数 / 已完成 / 错题数 -->
      <view class="row gap-2 stats-row">
        <view class="stat-box">
          <text class="stat-num">{{bank.total}}</text>
          <text class="stat-label">总题数</text>
        </view>
        <view class="stat-box">
          <text class="stat-num c-teal">{{progress}}</text>
          <text class="stat-label">已完成</text>
        </view>
        <view class="stat-box">
          <text class="stat-num c-red">{{wrongCount}}</text>
          <text class="stat-label">错题数</text>
        </view>
      </view>

      <!-- 测评题库：单一入口 -->
      <view wx:if="{{isAssessment}}" class="mt-4">
        <button class="g-btn g-btn-primary assess-btn" hover-class="btn-hover" bindtap="startAssessment">▶ 开始测评（{{assessCount}} 题）</button>
        <text class="assess-hint">按直觉作答即可，完成后将生成专属{{reportWord}}测评报告</text>
      </view>

      <!-- 普通题库：三个刷题入口 -->
      <view wx:else class="row gap-2 mt-4">
        <button class="g-btn g-btn-primary action-btn" hover-class="btn-hover" bindtap="startPractice">▶ 继续练习</button>
        <button class="g-btn g-btn-ghost action-btn {{loadingRandom ? 'g-btn-disabled' : ''}}" hover-class="btn-hover" bindtap="startRandom">⚡ {{loadingRandom ? '抽题中…' : '随机10题'}}</button>
        <button class="g-btn g-btn-ghost action-btn {{loadingWrong ? 'g-btn-disabled' : ''}}" hover-class="btn-hover" bindtap="startWrong">📖 {{loadingWrong ? '加载中…' : '错题重练'}}</button>
      </view>

      <!-- 题目目录 -->
      <view class="mt-5">
        <text class="list-title">📋 题目列表</text>
        <view wx:if="{{questions.length === 0}}" class="empty">
          <text class="empty-emoji">📭</text>
          <text>该题库暂无题目</text>
        </view>
        <view wx:else class="q-list">
          <view
            wx:for="{{questions}}"
            wx:key="idx"
            class="g-card q-item {{item.done ? 'q-item-done' : ''}}"
            hover-class="q-item-hover"
            data-idx="{{item.idx}}"
            bindtap="onQuestionTap"
          >
            <view class="q-no {{item.done ? 'q-no-done' : ''}}">{{item.no}}</view>
            <text class="grow q-text">{{item.q}}</text>
            <text wx:if="{{item.done}}" class="q-done-mark">✅</text>
          </view>
        </view>
      </view>
      <view class="safe-bottom"></view>
    </view>
  </view>
</block>

<!-- 加载中 / 加载失败 -->
<block wx:else>
  <view class="page">
    <view class="empty">
      <text class="empty-emoji">🌊</text>
      <text>{{loading ? '加载中...' : '题库不存在或加载失败'}}</text>
    </view>
  </view>
</block>
