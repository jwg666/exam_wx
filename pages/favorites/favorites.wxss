/* 我的收藏（对齐 Web pages/favorites.vue） */
.fv-page {
  padding-bottom: 64rpx;
  box-sizing: border-box;
}

/* ---------- 页头 ---------- */
.fv-header { min-height: 88rpx; }
.fv-count {
  font-size: 28rpx;
  font-weight: 500;
  color: #94A3B8;
}
.fv-count-num {
  color: #FBBF24;
  font-weight: 700;
}

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #243049;
  border-top-color: #14B8A6;
  border-radius: 50%;
  animation: fv-spin 0.8s linear infinite;
}
@keyframes fv-spin {
  to { transform: rotate(360deg); }
}

/* ---------- 空态 ---------- */
.fv-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}
.fv-empty-icon {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: #162032;
  border: 1rpx solid rgba(36, 48, 73, 0.5);
  box-shadow: inset 0 0 20rpx rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
}
.fv-empty-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #94A3B8;
}
.fv-go {
  width: 280rpx;
  padding: 18rpx 0;
  margin-top: 48rpx;
  font-size: 28rpx;
}

/* ---------- 收藏卡 ---------- */
.fv-card {
  position: relative;
  overflow: hidden;
  margin: 0 40rpx 32rpx;
}
.fv-stripe {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #FBBF24, #F97316);
}
.fv-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.fv-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.fv-type {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  margin-top: 4rpx;
}
.tag-single { background: rgba(20, 184, 166, 0.2); color: #2DD4BF; }
.tag-judge { background: rgba(59, 130, 246, 0.2); color: #60A5FA; }
.tag-multi { background: rgba(139, 92, 246, 0.2); color: #C084FC; }
.fv-question {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #E8EDF5;
  text-align: justify;
}
.fv-del {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #162032;
  border: 1rpx solid #243049;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.fv-del:active { background: rgba(245, 158, 11, 0.2); }

/* ---------- 答案 / 解析 ---------- */
.fv-body { margin-bottom: 16rpx; }
.fv-ans {
  display: block;
  font-size: 28rpx;
  color: #94A3B8;
  line-height: 1.6;
}
.fv-ans-val {
  color: #4ADE80;
  font-weight: 700;
}
.fv-exp {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
  margin-top: 16rpx;
}

/* ---------- 底部 ---------- */
.fv-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid #243049;
  font-size: 24rpx;
  font-weight: 500;
  color: #64748B;
}
.fv-bank { color: #64748B; }
.fv-retry {
  color: #2DD4BF;
  font-weight: 700;
}
.fv-retry:active { color: #5EEAD4; }
