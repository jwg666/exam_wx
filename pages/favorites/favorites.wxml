<view class="page fv-page">

  <!-- 未登录空态（登录守卫触发） -->
  <view wx:if="{{guest}}" class="empty">
    <text class="empty-emoji">🔐</text>
    <text>登录后查看我的收藏</text>
  </view>

  <block wx:else>
    <!-- 页头：标题 + 共 N 题 -->
    <view class="page-header fv-header">
      <text class="section-title">收藏夹</text>
      <text class="fv-count">共 <text class="fv-count-num">{{total}}</text> 题</text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="spinner"></view>
    </view>

    <!-- 空态（对齐 Web：暂无收藏） -->
    <view wx:elif="{{list.length === 0}}" class="fv-empty fade-up">
      <view class="fv-empty-icon"><text>⭐</text></view>
      <text class="fv-empty-text">暂无收藏</text>
      <view class="g-btn g-btn-primary fv-go" bindtap="goPractice">去刷题 ›</view>
    </view>

    <block wx:else>
      <!-- 收藏列表 -->
      <view
        class="g-card fv-card fade-up"
        wx:for="{{list}}"
        wx:key="id"
        style="animation-delay: {{item.delay}}s;"
      >
        <view class="fv-stripe"></view>

        <!-- 题型标签 + 题干 + 取消收藏 -->
        <view class="fv-top">
          <view class="fv-head">
            <text class="g-tag fv-type {{item.typeCls}}">{{item.typeLabel}}</text>
            <text class="fv-question">{{item.question}}</text>
          </view>
          <view class="fv-del" data-qid="{{item.questionId}}" bindtap="onRemove">⭐</view>
        </view>

        <!-- 正确答案 + 解析 -->
        <view class="fv-body">
          <text class="fv-ans">正确答案：<text class="fv-ans-val">{{item.ansText}}</text></text>
          <text wx:if="{{item.hasExp}}" class="fv-exp">{{item.exp}}</text>
        </view>

        <!-- 底部：来源题库 + 重做 -->
        <view class="fv-foot">
          <text class="fv-bank">📖 {{item.bankName}}</text>
          <text class="fv-retry" data-qid="{{item.questionId}}" bindtap="onRetry">🔄 重做</text>
        </view>
      </view>
    </block>
  </block>
</view>
